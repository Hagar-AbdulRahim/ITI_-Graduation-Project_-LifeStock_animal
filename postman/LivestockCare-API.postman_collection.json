    {
      "name": "Doctor Dashboard",
      "item": [
        {
          "name": "Dashboard Stats",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Doctor dashboard stats OK', () => {",
                "  pm.response.to.have.status(200);",
                "  const data = pm.response.json().data;",
                "  pm.expect(data).to.have.property('open_cases');",
                "  pm.expect(data).to.have.property('consultations_today');",
                "  pm.expect(data).to.have.property('active_outbreaks');",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doctor/dashboard/stats" }
        },
        {
          "name": "List Health Cases",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doctor/health-cases?page=1&limit=15&status=open" }
        },
        {
          "name": "Review Health Case",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vet_notes\": \"يُنصح بعزل الحيوان ومراجعة الطبيب\",\n  \"severity\": \"yellow\",\n  \"recommended_treatment\": \"مضاد حيوي + راحة\"\n}"
            },
            "url": "{{baseUrl}}/api/doctor/health-cases/{{healthCaseId}}/review"
          }
        },
        {
          "name": "List Pending Consultations",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doctor/consultations?page=1&limit=15" }
        },
        {
          "name": "Respond Consultation",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_response\": \"يُنصح بمراجعة الطبيب البيطري في أقرب وقت\"\n}"
            },
            "url": "{{baseUrl}}/api/doctor/consultations/{{consultationId}}/respond"
          }
        },
        {
          "name": "List Outbreaks",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doctor/outbreaks?status=active" }
        }
      ]
    }
  ]
}
