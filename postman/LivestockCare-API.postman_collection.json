          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal_id\": \"{{animalId}}\",\n  \"vaccine_name\": \"حمى القلاع\",\n  \"vaccine_type\": \"recurring\",\n  \"last_date\": \"2025-06-01\",\n  \"next_due_date\": \"2026-06-01\",\n  \"dose_ml\": 2\n}"
            },
            "url": "{{baseUrl}}/api/vaccinations"
          }
        },
        {
          "name": "Get Vaccinations By Animal",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/vaccinations/animal/{{animalId}}" }
        },
        {
          "name": "Get Vaccination By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}" }
        },
        {
          "name": "Update Vaccination",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"تم التطعيم بنجاح\"\n}" },
            "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}"
          }
        },
        {
          "name": "Delete Vaccination",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}" }
        }
      ]
    },
    {
      "name": "Health Cases",
      "item": [
        {
          "name": "Diagnose (Text)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200 || pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  const id = json.data?._id || json.healthCase?._id;",
                "  if (id) pm.collectionVariables.set('healthCaseId', id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal_id\": \"{{animalId}}\",\n  \"symptoms\": [\"حمى\", \"فقدان شهية\", \"إسهال\"],\n  \"input_type\": \"text\"\n}"
            },
            "url": "{{baseUrl}}/api/health-cases/diagnose"
          }
        },
        {
          "name": "Diagnose (General Consultation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symptoms\": [\"سعال\", \"ضعف عام\"],\n  \"input_type\": \"text\"\n}"
            },
            "url": "{{baseUrl}}/api/health-cases/diagnose"
          }
        },
        {
          "name": "Get Cases By Animal",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health-cases/animal/{{animalId}}" }
        },
        {
          "name": "Get My Consultations",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health-cases/consultations" }
        },
        {
          "name": "Get Case By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health-cases/{{healthCaseId}}" }
        },
        {
          "name": "Resolve Case",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
