{
  "info": {
    "name": "LivestockCare AI - Full API",
    "_postman_id": "livestock-care-api-v1",
    "description": "Complete API collection for LivestockCare AI app.\n\n## Setup\n1. Import this collection and the environment file.\n2. Run **Auth > Login (Farmer)** or **Login (Admin)** first.\n3. Token is saved automatically to `accessToken`.\n4. Run **Farms > Create Farm** then copy `_id` to `farmId` variable.\n5. Run **Animals > Create Animal** then copy `_id` to `animalId`.\n\n## Test Accounts\n- Admin: `admin@livestock.ai` (seed with `npm run seed:admin` in backend)\n- Farmer: register via **Register** then verify email\n\n## Dashboard Endpoints\n- Farmer: `GET /api/farms/:id/stats`\n- Admin: `GET /api/admin/dashboard/stats`\n- Doctor: `GET /api/doctor/dashboard/stats`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "farmId", "value": "" },
    { "key": "animalId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "healthCaseId", "value": "" },
    { "key": "vaccinationId", "value": "" },
    { "key": "consultationId", "value": "" },
    { "key": "outbreakId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Farmer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"مزارع تجريبي\",\n  \"email\": \"farmer@test.com\",\n  \"phone\": \"01012345678\",\n  \"password\": \"Test1234\",\n  \"governorate\": \"القاهرة\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (Farmer)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                "  if (json.user?._id) pm.collectionVariables.set('userId', json.user._id);",
                "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@test.com\",\n  \"password\": \"Test1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (Admin)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                "  pm.test('Admin login successful', () => pm.response.to.have.status(200));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@livestock.ai\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/verify-email?token=YOUR_TOKEN"
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"farmer@test.com\"\n}" },
            "url": "{{baseUrl}}/api/auth/resend-verification"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"farmer@test.com\"\n}" },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@test.com\",\n  \"otp\": \"123456\",\n  \"new_password\": \"NewTest1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"مزارع محدّث\",\n  \"governorate\": \"الجيزة\"\n}" },
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Test1234\",\n  \"new_password\": \"NewTest1234\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me/password"
          }
        },
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fcm_token\": \"sample-fcm-token\"\n}" },
            "url": "{{baseUrl}}/api/users/me/fcm-token"
          }
        },
        {
          "name": "Delete Account",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/me" }
        }
      ]
    },
    {
      "name": "Farms (Farmer Dashboard)",
      "item": [
        {
          "name": "Create Farm",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  if (json.data?._id) pm.collectionVariables.set('farmId', json.data._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"مزرعة النيل\",\n  \"governorate\": \"القاهرة\",\n  \"description\": \"مزرعة تجريبية للاختبار\"\n}"
            },
            "url": "{{baseUrl}}/api/farms"
          }
        },
        {
          "name": "Get My Farms",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/farms" }
        },
        {
          "name": "Get Farm By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/farms/{{farmId}}" }
        },
        {
          "name": "Get Farm Stats (Dashboard)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Stats response has dashboard fields', () => {",
                "  const json = pm.response.json();",
                "  pm.expect(json.success).to.be.true;",
                "  pm.expect(json.data.stats).to.have.property('total_animals');",
                "  pm.expect(json.data.stats).to.have.property('upcoming_vaccinations');",
                "  pm.expect(json.data.stats).to.have.property('weekly_health_trends');",
                "  pm.expect(json.data.stats).to.have.property('ai_recommendations');",
                "  pm.expect(json.data.stats).to.have.property('recent_activities');",
                "});"
              ],
              "type": "text/javascript"
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/farms/{{farmId}}/stats" }
        },
        {
          "name": "Update Farm",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"مزرعة النيل المحدّثة\"\n}" },
            "url": "{{baseUrl}}/api/farms/{{farmId}}"
          }
        },
        {
          "name": "Delete Farm",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/farms/{{farmId}}" }
        }
      ]
    },
    {
      "name": "Animals",
      "item": [
        {
          "name": "Create Animal",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  if (json.data?._id) pm.collectionVariables.set('animalId', json.data._id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": \"{{farmId}}\",\n  \"tag_number\": \"EG-001\",\n  \"species\": \"cattle\",\n  \"gender\": \"female\",\n  \"age_value\": 2,\n  \"age_unit\": \"years\",\n  \"weight_kg\": 450,\n  \"breed\": \"فriesian\"\n}"
            },
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Get Animals By Farm",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/animals/farm/{{farmId}}" }
        },
        {
          "name": "Get Animal By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/animals/{{animalId}}" }
        },
        {
          "name": "Update Animal",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"weight_kg\": 460,\n  \"health_status\": \"healthy\"\n}" },
            "url": "{{baseUrl}}/api/animals/{{animalId}}"
          }
        },
        {
          "name": "Delete Animal",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/animals/{{animalId}}" }
        }
      ]
    },
    {
      "name": "Vaccinations",
      "item": [
        {
          "name": "Create Vaccination (Recurring)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  if (json.data?._id) pm.collectionVariables.set('vaccinationId', json.data._id);",
                "}"
              ],
